{
  "name": "@handijitcom/memoizer",
  "version": "1.0.1",
  "description": "Fast, dependency-free memoization for JavaScript and TypeScript functions, with dependency tracking, LRU eviction and TTL.",
  "author": "Ahmet ilhan <ahmetilhn.dev@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/handijit/memoizer.git"
  },
  "homepage": "https://github.com/handijit/memoizer#readme",
  "bugs": {
    "url": "https://github.com/handijit/memoizer/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./build/index.cjs",
  "module": "./build/index.mjs",
  "types": "./build/index.d.ts",
  "unpkg": "./build/index.umd.js",
  "jsdelivr": "./build/index.umd.js",
  "exports": {
    ".": {
      "import": {
        "types": "./build/index.d.mts",
        "default": "./build/index.mjs"
      },
      "require": {
        "types": "./build/index.d.ts",
        "default": "./build/index.cjs"
      },
      "default": "./build/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "build",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "prettier": "@handijitcom/config/prettier",
  "scripts": {
    "build": "sh ./scripts/prod-build.sh",
    "dev": "sh ./scripts/dev-build.sh",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run --coverage",
    "size": "node ./scripts/report-size.mjs",
    "lint:package": "publint && attw --pack .",
    "test:smoke": "sh ./scripts/smoke-test.sh",
    "bench": "node ./scripts/bench.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build && npm run size && npm run lint:package",
    "prepublishOnly": "npm run verify"
  },
  "keywords": [
    "memoization",
    "cache",
    "lru",
    "ttl",
    "performance",
    "optimization",
    "function",
    "memoize",
    "typescript",
    "javascript",
    "utility",
    "usememo",
    "use-memo",
    "memoizer",
    "cacheable functions",
    "react",
    "vue",
    "nuxt",
    "nextjs",
    "ssr",
    "memofy",
    "handijit"
  ],
  "private": false,
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@handijitcom/config": "^1.0.0",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^26.2.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "rollup": "^4.62.4",
    "rollup-plugin-dts": "^6.5.1",
    "tslib": "^2.8.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.1.0"
  }
}
